# Copy this file to .env and add your key. Never commit .env.

# Free Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: the reader the app and the API use (gemini | donut | ocr-rules)
INVOICEIQ_EXTRACTOR=gemini
# Optional: the Gemini model, and the models to switch to when its free quota runs out
INVOICEIQ_GEMINI_MODEL=gemini-3.5-flash-lite
INVOICEIQ_GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.6-flash,gemini-3.8-flash
# Optional: thinking level for Gemini 3 models (minimal | low | medium | high)
INVOICEIQ_THINKING_LEVEL=low
# Optional: confirm every amount against local OCR of the page (true | false)
INVOICEIQ_CHECK_PRINTED=true
# Optional, public demo only: live Gemini runs per visitor and per day (0 = no limit)
INVOICEIQ_DEMO_SESSION_LIMIT=0
INVOICEIQ_DEMO_DAILY_LIMIT=0
